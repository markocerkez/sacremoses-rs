from typing import Optional

class Tokenizer:
    def __init__(self, lang: str, is_alnum: str, is_alpha: str, is_n: str, is_lower: str,
                 nonbreaking_prefixes: list[str], numeric_only_prefixes: list[str]) -> None: ...
    def tokenize(self, text: str, aggressive_dash_splits: bool, escape: bool) -> str: ...
    def tokenize_split(self, text: str, aggressive_dash_splits: bool, escape: bool) -> list[str]: ...
    def tokenize_many(self, texts: list[str], aggressive_dash_splits: bool, escape: bool) -> list[str]: ...

class Normalizer:
    def __init__(self, substitutions: list[tuple[str, str]], replace_unicode_punct: list[tuple[str, str]],
                 pre_replace_unicode_punct: bool, post_remove_control_chars: bool) -> None: ...
    def normalize(self, text: str) -> str: ...
    def normalize_many(self, texts: list[str]) -> list[str]: ...

class Detokenizer:
    def __init__(self, lang: str, is_alpha: str, is_sc: str, cjk_ranges: list[tuple[int, int]],
                 finnish_pattern: str) -> None: ...
    def detokenize(self, tokens: list[str], unescape: bool) -> Optional[str]: ...
    def detokenize_many(self, batch: list[list[str]], unescape: bool) -> list[Optional[str]]: ...
